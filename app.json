{
  "expo": {
    "name": "CleanOS",
    "slug": "cleanos-android",
    "version": "1.0.2",
    "scheme": "cleanos",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/cleanos-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.auratradings.cleanos",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#102D3D",
        "foregroundImage": "./assets/cleanos-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui"
    ]
  }
}
